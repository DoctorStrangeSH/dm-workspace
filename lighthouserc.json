{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/dashboard",
        "http://localhost:3000/campaign/[id]",
        "http://localhost:3000/campaign/[id]/chapters/[chapterId]",
        "http://localhost:3000/campaign/[id]/characters/[characterId]",
        "http://localhost:3000/campaign/[id]/scenes/[sceneId]"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
