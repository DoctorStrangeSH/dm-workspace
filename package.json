{
  "name": "dm-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:smoke": "playwright test tests/smoke.spec.ts",
    "test:e2e:screenshots": "playwright test tests/screenshots.spec.ts",
    "seed:test": "tsx scripts/seed-test-user.ts",
    "test:security:pr37": "node scripts/check-pr37-security.mjs && node --import tsx --test tests/visible-handout.test.ts",
    "test:hp:harness": "node --test tests/dev-hp-concurrency.test.mjs",
    "test:campaign-ui": "node --import tsx --test tests/campaign-nav-items.test.ts tests/campaign-overview-time.test.ts && node tests/campaign-ui/run.mjs",
    "test:characters": "node --import tsx --test tests/character-hp-level-up.test.ts tests/character-actions.test.ts tests/level-up-dialog.test.ts tests/character-identity-patch.test.ts tests/character-display-names.test.ts tests/srd-class-utils.test.ts tests/character-creation.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
